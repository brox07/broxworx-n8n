    {
      "parameters": {
        "jsCode": "\nconst events = [];\nlet currentSeries = \"\";\nlet currentTrack = \"\";\n\n// Pre-compiled regex patterns\nconst discordEmojiRegex = /<:[a-zA-Z0-9_]+:\\d+>/g;\nconst timestampRegex = /<t:(\\d+):[a-zA-Z]>/;\nconst flagsRegex = /[\\uD83C][\\uDDE6-\\uDDFF]/g; \nconst typeKeywords = ['qualifying', 'practice', 'race', 'broadcast', 'test', 'warmup', 'sprint'];\n\nconst lines = $input.first().json.content.split('\\n');\n\nfor (let line of lines) {\n  line = line.trim();\n  if (!line || line.startsWith('-#')) continue;\n\n  // --- 1. HANDLE HEADINGS ---\n  if (line.startsWith('###')) {\n    let cleanLine = line.replace('###', '').trim();\n    cleanLine = cleanLine.replace(discordEmojiRegex, '');\n    cleanLine = cleanLine.replace(flagsRegex, '');\n    \n    // Split series and track by em-dash or standard dash\n    const parts = cleanLine.split(/\\s+—\\s+|\\s+--\\s+|\\s+-\\s+/);\n    if (parts.length >= 2) {\n      currentSeries = parts[0].trim();\n      currentTrack = parts.slice(1).join(' - ').trim();\n    }\n    continue;\n  }\n\n  // --- 2. HANDLE EVENT LINES ---\n  if (line.startsWith('-') && line.includes('<t:')) {\n    const timeMatch = line.match(timestampRegex);\n    if (!timeMatch) continue;\n\n    const unixTimestamp = parseInt(timeMatch[1], 10);\n    \n    const date = new Date(unixTimestamp * 1000);\n    // Render the event time in America/Chicago, honoring CST/CDT automatically.\n    const tz = \"America/Chicago\";\n    const offset = new Intl.DateTimeFormat(\"en-US\", { timeZone: tz, timeZoneName: \"longOffset\" })\n      .formatToParts(date).find(p => p.type === \"timeZoneName\").value.replace(\"GMT\", \"\") || \"+00:00\";\n    const wallClock = new Intl.DateTimeFormat(\"sv-SE\", {\n      timeZone: tz, year: \"numeric\", month: \"2-digit\", day: \"2-digit\",\n      hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\", hour12: false,\n    }).format(date);\n    const eventTime = wallClock.replace(\" \", \"T\") + offset;\n\n    // Clean the event string\n    let textAfterTime = line.replace(/^-\\s*<t:\\d+:[a-zA-Z]>\\s*(?:—|-)?\\s*/, '');\n    \n    // Split by semicolon to drop extra broadcast/flag data\n    let mainEventText = textAfterTime.split(';')[0];\n    \n    // Strip out Discord emojis and markdown italics/bold\n    mainEventText = mainEventText.replace(discordEmojiRegex, '');\n    mainEventText = mainEventText.replace(/\\*\\*.*?\\*\\*|\\*.*?\\*/g, '').trim();\n\n    // --- 3. PARSE SUBSERIES, NAME, AND TYPE ---\n    let subseries = \"\";\n    let eventName = \"\";\n    let eventType = \"\";\n\n    const detailParts = mainEventText.split(/\\s+-\\s+|\\s+—\\s+/);\n    let eventString = \"\";\n\n    if (detailParts.length >= 2) {\n      subseries = detailParts[0].trim();\n      eventString = detailParts.slice(1).join(' - ').trim();\n    } else {\n      eventString = detailParts[0].trim();\n    }\n\n    // Determine if the string is an event TYPE or an event NAME\n    const isType = typeKeywords.some(keyword => eventString.toLowerCase().includes(keyword));\n    if (isType) {\n      eventType = eventString;\n    } else {\n      eventName = eventString;\n    }\n\n    // Push to events array\n    events.push({\n      event_time: eventTime,\n      series: currentSeries,\n      subseries: subseries,\n      event_type: eventType,\n      event_name: eventName,\n      race_track: currentTrack\n    });\n  }\n}\n\n// Return the structured data in the format n8n expects\nreturn [{\n  json: {\n    event: events\n  }\n}];"
      },
