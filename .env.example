# Copy to .env and fill in real values. Never commit the populated .env.

# Postgres — backing store for n8n
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# Cloudflare Tunnel token for exposing n8n without opening inbound ports.
# Create at: Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Public URL n8n advertises for webhooks and the editor
WEBHOOK_URL=https://n8n.example.com/
N8N_HOST=n8n.example.com
N8N_PORT=5678
